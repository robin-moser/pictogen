{
  "name": "pictogen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run typecheck && npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc --project tsconfig.server.json",
    "dev": "concurrently --kill-others --names server,client --prefix-colors blue,magenta npm:dev:server npm:dev:client",
    "dev:client": "vite",
    "dev:server": "tsx watch --env-file-if-exists=.env server/main.ts",
    "db:generate": "drizzle-kit generate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "thumbnails:regenerate": "tsx scripts/regenerate-thumbnails.ts",
    "start": "node --env-file-if-exists=.env dist/server/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "user:set-password": "node --env-file-if-exists=.env dist/scripts/set-password.js"
  },
  "dependencies": {
    "@egjs/grid": "^1.18.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/proxy-addr": "^5.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@sinclair/typebox": "^0.34.52",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "blurhash": "^2.0.5",
    "drizzle-orm": "^0.45.2",
    "fast-blurhash": "^1.2.0",
    "fastify": "^5.12.1",
    "heic-decode": "^2.1.0",
    "preact": "^10.29.8",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "concurrently": "^10.0.5",
    "daisyui": "^5.7.22",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
