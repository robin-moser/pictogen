OPENROUTER_API_KEY=replace-me
PUBLIC_URL=http://localhost:3000
AUTH_MODE=local

# Local mode only. Omit ADMIN_PASSWORD to generate a temporary password at startup.
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-at-least-8-characters

# Complete additional origins, including scheme and port, separated by commas.
# TRUSTED_ORIGINS=https://pictogen.example.com

# Generic forwarded-header trust is separate from authentication and defaults to false.
# TRUST_PROXY=false

# ForwardAuth mode only. Trust the direct proxy peer using exact addresses or narrow CIDRs.
# FORWARD_AUTH_USER_HEADER=Remote-User
# FORWARD_AUTH_TRUSTED_PROXIES=127.0.0.1
